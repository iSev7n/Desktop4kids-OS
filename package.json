{
  "name": "desktop4kids-os",
  "version": "1.2.1",
  "description": "Windows-like desktop shell for kids, built with Electron",
  "author": "Thomas Davis",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electronmon .",
    "build": "npm run dist",
    "dist": "electron-builder -w",
    "setup:mentor": "npx --no node-llama-cpp source download || npx --no node-llama-cpp source build --gpu auto --nodeTarget v22.20.0"
  },
  "devDependencies": {
    "electron": "^38.3.0",
    "electron-builder": "^24.13.3",
    "electron-reload": "^2.0.0-alpha.1",
    "electronmon": "^2.0.2"
  },
  "build": {
    "appId": "com.desktop4kids.desktop",
    "productName": "Desktop4Kids",
    "files": [
      "index.html",
      "main.js",
      "renderer.js",
      "assets/**/*",
      "apps/**/*",
      "global-style.css",
      "taskbar.css",
      "taskbar.js",
      "startmenu.css",
      "startmenu.js",
      "settings.*",
      "explorer.*",
      "mediacenter.*",
      "accounts.*",
      "mentor.*",
      "ai-worker.*"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "models/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/favicon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iSev7n",
        "repo": "Desktop4kids-OS"
      }
    ]
  },
  "dependencies": {
    "node-llama-cpp": "^3.12.0"
  }
}
