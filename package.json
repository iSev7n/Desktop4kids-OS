{
  "name": "desktop4kids-os",
  "version": "1.3.0",
  "repository": "https://github.com/iSev7n/Desktop4kids-OS",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electronmon .",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -w",
    "dist:zip": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -w zip",
    "dist:portable": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -w portable",
    "release:publish": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -w --publish always"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^38.3.0",
    "electron-builder": "^24.13.3",
    "electron-reload": "^2.0.0-alpha.1",
    "electronmon": "^2.0.2"
  },
  "build": {
    "appId": "com.desktop4kids.desktop",
    "productName": "Desktop4Kids",
    "files": [
      "index.html",
      "main.js",
      "renderer.js",
      "assets/**/*",
      "apps/**/*",
      "global-style.css",
      "accounts.*",
      "taskbar.*",
      "startmenu.*",
      "models/**/*",
      "!**/*.map",
      "!**/node_modules/**/{test,__tests__,example,examples}/**"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "models/**"
    ],
    "win": {
      "target": ["zip"],
      "icon": "assets/favicon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iSev7n",
        "repo": "Desktop4kids-OS"
      }
    ]
  },
  "dependencies": {
    "node-llama-cpp": "^3.12.0"
  }
}
